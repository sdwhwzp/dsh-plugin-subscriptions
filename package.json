{
  "name": "dsh-plugin-subscriptions",
  "version": "0.9.2-dsh.20260917.1",
  "description": "Use ChatGPT (Codex), Claude, Grok (X Premium), GitHub Copilot, and Google Antigravity subscriptions as DeepSeek Harness LLM providers, with OAuth login from the web Settings page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V1ki/dsh-plugin-subscriptions.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "oauth",
    "chatgpt",
    "codex",
    "claude",
    "grok",
    "github-copilot",
    "google-antigravity"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "test": "tsc -p tsconfig.test.json && node --test lib-test/test/",
    "prepare": "tsdown -c tsdown.prepare.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1 || ^0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-attachment": "link:../../deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-client-connection": "link:../../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-commands": "link:../../deepseek-harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-home-paths": "link:../../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-tools": "link:../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "link:../../deepseek-harness/node_modules/.pnpm/node_modules/react",
    "react-dom": "link:../../deepseek-harness/node_modules/.pnpm/node_modules/react-dom",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0",
    "@deepseek-ai/dsh-commands": "link:../../deepseek-harness/packages/interaction/commands"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependenciesMeta": {
